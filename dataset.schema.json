{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phi-jepa:dataset:1.0.0",
  "title": "Phi-JEPA Dataset Contract 1.0.0",
  "description": "Schema structure only. Semantic gates in SPECIFICATION.md are mandatory. Illustrative records cannot enter benchmark exports.",
  "$ref": "#/$defs/record",
  "$defs": {
    "quantity": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_id",
        "name",
        "value",
        "unit",
        "frame"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subject_id",
        "predicate",
        "object_id"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          },
          "minItems": 0
        }
      },
      "required": [
        "entity_id",
        "type",
        "properties"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "step_index": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "number",
          "minimum": 0
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          },
          "minItems": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0
        },
        "context": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state_id",
        "step_index",
        "timestamp",
        "measurements",
        "relations",
        "context"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "start_time": {
          "type": "number",
          "minimum": 0
        },
        "end_time": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "event_id",
        "start_time",
        "end_time",
        "type",
        "parameters",
        "description"
      ],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "start_time": {
          "type": "number",
          "minimum": 0
        },
        "end_time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "string",
          "minLength": 1
        },
        "interpolation": {
          "enum": [
            "constant"
          ]
        }
      },
      "required": [
        "entity_id",
        "channel",
        "start_time",
        "end_time",
        "value",
        "unit",
        "frame",
        "interpolation"
      ],
      "additionalProperties": false
    },
    "controller": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "explicit_schedule",
            "fully_specified_feedback"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "equations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          },
          "minItems": 0
        },
        "initial_internal_state": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          },
          "minItems": 0
        },
        "update_interval_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          },
          "minItems": 0
        }
      },
      "required": [
        "mode",
        "description",
        "equations",
        "parameters",
        "initial_internal_state",
        "update_interval_s",
        "controls"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "answer_type": {
          "enum": [
            "number",
            "vector",
            "integer",
            "boolean",
            "category"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "string",
          "minLength": 1
        },
        "query_kind": {
          "enum": [
            "at_time",
            "over_interval"
          ]
        },
        "start_time": {
          "type": "number",
          "minimum": 0
        },
        "end_time": {
          "type": "number",
          "minimum": 0
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_definition": {
          "type": "string",
          "minLength": 1
        },
        "absolute_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "relative_tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "target_id",
        "entity_id",
        "quantity",
        "answer_type",
        "unit",
        "frame",
        "query_kind",
        "start_time",
        "end_time",
        "rule_id",
        "rule_definition",
        "absolute_tolerance",
        "relative_tolerance"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "domain": {
          "enum": [
            "robotic_arm",
            "driving",
            "object_pushing_stacking",
            "quadruped_locomotion",
            "tethered_load"
          ]
        },
        "task_type": {
          "enum": [
            "future_state_prediction",
            "future_event_prediction"
          ]
        },
        "global_context": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "minItems": 1
        },
        "coordinate_convention": {
          "type": "string",
          "minLength": 1
        },
        "observation_cutoff": {
          "type": "number",
          "minimum": 0
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 1
        },
        "controller": {
          "$ref": "#/$defs/controller"
        },
        "known_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0
        },
        "answer_spec": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1
        }
      },
      "required": [
        "domain",
        "task_type",
        "global_context",
        "question",
        "entities",
        "coordinate_convention",
        "observation_cutoff",
        "states",
        "controller",
        "known_events",
        "answer_spec"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target_id",
        "value",
        "unit",
        "frame"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "state_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "state_ids",
        "event_ids",
        "description"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0
        },
        "structured_label": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          },
          "minItems": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "explanation_kind": {
          "enum": [
            "descriptive",
            "controlled_comparison"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "solution_trace": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unavailable",
                "candidate",
                "verified"
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "verification_record": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "steps",
            "verification_record"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "states",
        "events",
        "structured_label",
        "label",
        "explanation",
        "explanation_kind",
        "evidence",
        "solution_trace"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "status",
        "details"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role",
        "path",
        "sha256",
        "license"
      ],
      "additionalProperties": false
    },
    "shift": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "training_support": {
          "type": "string",
          "minLength": 1
        },
        "test_support": {
          "type": "string",
          "minLength": 1
        },
        "actual_value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "parameter",
        "unit",
        "training_support",
        "test_support",
        "actual_value"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "record_origin": {
          "enum": [
            "simulation",
            "illustrative_only"
          ]
        },
        "base_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "split_group_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "development",
            "train",
            "validation",
            "test_id",
            "test_ood"
          ]
        },
        "distribution": {
          "enum": [
            "id",
            "parameter_extrapolation",
            "unseen_combination",
            "timed_event",
            "structural",
            "cross_simulator",
            "illustrative"
          ]
        },
        "shifts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shift"
          },
          "minItems": 0
        },
        "simulation": {
          "type": "object",
          "properties": {
            "engine": {
              "enum": [
                "mujoco",
                "pybullet",
                "mjx"
              ]
            },
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "engine_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "assets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/asset"
              },
              "minItems": 0
            },
            "generator_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "config_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "integration_timestep_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "saved_state_interval_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "solver_settings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/quantity"
              },
              "minItems": 0
            },
            "dtype": {
              "type": "string",
              "minLength": 1
            },
            "runtime_environment": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/quantity"
              },
              "minItems": 0
            }
          },
          "required": [
            "engine",
            "implementation",
            "engine_version",
            "model_id",
            "assets",
            "generator_commit",
            "config_sha256",
            "seed",
            "integration_timestep_s",
            "saved_state_interval_s",
            "duration_s",
            "solver_settings",
            "dtype",
            "runtime_environment"
          ],
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "accepted",
                "rejected",
                "illustrative_only"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              },
              "minItems": 0
            }
          },
          "required": [
            "status",
            "checks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_origin",
        "base_scenario_id",
        "split_group_id",
        "split",
        "distribution",
        "shifts",
        "simulation",
        "validation"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "schema_version",
        "sample_id",
        "input",
        "reference",
        "metadata"
      ],
      "additionalProperties": false
    },
    "public_record": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/input"
        }
      },
      "required": [
        "schema_version",
        "sample_id",
        "input"
      ],
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "samples": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "required": [
        "schema_version",
        "samples"
      ],
      "additionalProperties": false
    }
  }
}
