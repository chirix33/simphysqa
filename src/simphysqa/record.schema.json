{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simphysqa:record:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_schema_version",
    "sample_id",
    "trajectory_id",
    "question_type",
    "annotation_version",
    "source",
    "public",
    "private",
    "completion"
  ],
  "properties": {
    "schema_version": {
      "const": "simphysqa/0.1.0"
    },
    "source_schema_version": {
      "const": "1.0.0"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "question_type": {
      "enum": [
        "direct",
        "predictive",
        "counterfactual",
        "explanation",
        "clarification"
      ]
    },
    "annotation_version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "file_sha256",
        "record_sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "annotations"
      ],
      "properties": {
        "input": {
          "type": "object"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trajectory",
            "timestamps"
          ],
          "properties": {
            "trajectory": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "text",
                "bindings"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "generated_unreviewed",
                    "human_revised"
                  ]
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "bindings": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "uniqueItems": true
                }
              }
            },
            "timestamps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "text",
                  "bindings",
                  "state_id",
                  "timestamp"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "generated_unreviewed",
                      "human_revised"
                    ]
                  },
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "bindings": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "uniqueItems": true
                  },
                  "state_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timestamp": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "private": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "metadata",
        "evidence_bindings",
        "annotation_provenance"
      ],
      "properties": {
        "reference": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        },
        "evidence_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "kind",
              "state_ids",
              "event_ids",
              "evidence_ids"
            ],
            "properties": {
              "target_id": {
                "type": "string"
              },
              "kind": {
                "const": "recorded_readout"
              },
              "state_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "event_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "evidence_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "annotation_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "model_identity",
            "prompt_version",
            "schema_version",
            "generation_settings",
            "validation_failures",
            "attempts",
            "retries",
            "repairs"
          ],
          "properties": {
            "status": {
              "enum": [
                "legacy_import",
                "generated_unreviewed",
                "human_revised"
              ]
            },
            "model_identity": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompt_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "schema_version": {
              "type": "string"
            },
            "generation_settings": {
              "type": "object"
            },
            "validation_failures": {
              "type": "array"
            },
            "attempts": {
              "type": "array"
            },
            "retries": {
              "type": "integer",
              "minimum": 0
            },
            "repairs": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trajectory_description",
        "timestamp_descriptions",
        "direct_qa",
        "predictive_qa",
        "counterfactual_qa",
        "explanation_qa",
        "clarification_qa",
        "evidence_bindings"
      ],
      "properties": {
        "trajectory_description": {
          "type": "string"
        },
        "timestamp_descriptions": {
          "type": "string"
        },
        "direct_qa": {
          "type": "string"
        },
        "predictive_qa": {
          "type": "string"
        },
        "counterfactual_qa": {
          "type": "string"
        },
        "explanation_qa": {
          "type": "string"
        },
        "clarification_qa": {
          "type": "string"
        },
        "evidence_bindings": {
          "type": "string"
        }
      }
    }
  }
}
