"""Read-only audit and reproducible final summary for the bounded interface run."""
from p12_answer_interface import RUN, ROOT, LOCK, ASSET, CONDITIONS, checked_config
from p12_common import load, save
from phi_jepa.artifacts import digest, canonical
from phi_jepa.integration.readers import file_hash
from phi_jepa.integration.contracts import PublicProblem
from phi_jepa.providers.compact_answer import adapt_answer, compact_messages
from phi_jepa.providers.local_answer import LocalAnswerSettings
from phi_jepa.providers.constrained_local import prepare_request
from dataclasses import asdict
import json
import math
from collections import Counter


def main():
    cfg = checked_config(); ledger=load(RUN/'budget.json'); lock=load(LOCK)
    rows=load(RUN/'diagnostic-public.json'); by_id={r['sample_id']:r for r in rows}
    assert len(ledger['attempts'])<=48 and len({a['key'] for a in ledger['attempts']})==len(ledger['attempts'])
    assert ledger['deadline_unix']-ledger['started_unix'] <=7200.01
    checks=[]
    from p12_answer_interface import settings_and_tokenizer
    for condition in CONDITIONS:
        settings,tokenizer=settings_and_tokenizer(condition)
        for sid,row in by_id.items():
            result=load(RUN/'round-2'/condition/(sid+'.json'))
            p=PublicProblem.parse(row['public']); identity=result['identity']
            assert digest(identity)==result['request_sha256']
            assert identity==prepare_request(tokenizer,p,load(ASSET)['prompt'],settings)
            assert identity['messages']==compact_messages(p,load(ASSET)['prompt'])
            assert identity['settings']==json.loads(json.dumps(asdict(settings)))
            assert result['raw_completion']==tokenizer.decode(result['generated_token_ids'],skip_special_tokens=False)
            if result['answer'] is not None:
                assert canonical(adapt_answer(p,result['final_text']))==canonical(result['answer'])
            cp=result['constraint_processing']
            if settings.enable_thinking is True:
                marker=tokenizer.convert_tokens_to_ids('</think>')
                ids=result['generated_token_ids']
                if marker in ids:
                    assert cp['activation_offset']==ids.index(marker)+1
                    assert result['reasoning_token_ids']==ids[:cp['activation_offset']]
                    assert result['final_token_ids']==ids[cp['activation_offset']:]
                else:
                    assert not cp['constrained_final_steps'] and result['answer'] is None
            else:
                assert cp['activation_offset']==0 and result['reasoning_tokens']==0
            attempts=[a for a in ledger['attempts'] if a['key']==f'2:{condition}:{sid}']
            assert len(attempts)==1 and attempts[0]['status']=='finished'
            assert attempts[0]['request_sha256']==result['request_sha256']
            assert attempts[0]['finished_unix']<=ledger['deadline_unix']
            checks.append({'condition':condition,'sample_id':sid,'passed':True})
    assert file_hash(ASSET)==load(RUN/'config.json')['asset_sha256']
    old_source=load(RUN/'config.json')['source_files']; new_source=cfg['source_files']
    unchanged=['src/phi_jepa/providers/openai_answer.py','src/phi_jepa/typed_evaluation.py','src/phi_jepa/providers/local_answer.py']
    assert all(old_source[p]==new_source[p]==file_hash(ROOT/p) for p in unchanged)
    first_round=[a for a in ledger['attempts'] if a['round']==1]
    assert len(first_round)==8
    first_results=[load(RUN/'round-1'/a['condition']/(a['sample_id']+'.json')) for a in first_round]
    audit={'status':'passed','request_checks':checks,'total_attempts':len(ledger['attempts']),
           'attempts_by_round':dict(Counter(a['round'] for a in ledger['attempts'])),
           'model_window_elapsed_seconds':max(a['finished_unix'] for a in ledger['attempts'])-ledger['started_unix'],
           'first_round_runtime_failures':sum(r['status']=='runtime_failure' for r in first_results),
           'first_round_latency_seconds':sum(r['latency_seconds'] for r in first_results),
           'second_round_is_defect_retry':True,'automatic_retries':0,'output_repairs':0,
           'canonical_parser_and_scoring_unchanged':True,'original_model_lock_unchanged':file_hash(LOCK)==cfg['model_lock_sha256'],
           'audit_source_sha256':file_hash(__file__),'source_sha256':cfg['source_sha256']}
    save(RUN/'verification.json',audit)
    # A distinct candidate lock binds the new interface; do not rewrite historical qualification.
    candidate={'version':'p12-local-compact-interface-v1','full_study_authorized':False,
               'historical_model_lock_sha256':file_hash(LOCK),'prompt_sha256':file_hash(ASSET),
               'source_sha256':cfg['source_sha256'],'dependency_lock_sha256':cfg['dependency_lock_sha256'],
               'decoder':'xgrammar==0.1.19, CPU mask, final-only after native Qwen closing marker',
               'run_root':str(RUN),'validation_selection_sha256':cfg['selection_sha256'],
               'qualification_summary_sha256':file_hash(RUN/'evaluation/summary.json'),
               'canonical_parser_sha256':file_hash(ROOT/'src/phi_jepa/providers/openai_answer.py'),
               'models':{c:{'acquisition':lock[c]['acquisition'],'settings':lock[c]['qualified_settings']} for c in CONDITIONS}}
    save(ROOT/'configs/local_answers_p12.interface_v1.lock.json',candidate)
    save(RUN/'candidate-interface.lock.json',candidate)
    print(json.dumps(audit,indent=2))


if __name__=='__main__':main()
