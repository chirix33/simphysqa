"""Separate qualification run; no legacy budget/provider execution imports."""
from pathlib import Path
import json
import sys
import subprocess
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT/'src'))
from phi_jepa.artifacts import canonical, digest
from phi_jepa.integration.readers import file_hash, ReleaseCatalog
NATIVE = Path('/home/aashraf/phi-jepa')
def load(p): return json.loads(Path(p).read_text())
CONFIG = load(ROOT/'configs/qualification_p12.json')
OUT = Path(CONFIG['run_root'])
def save(p, value):
    p = Path(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    temp = p.with_suffix(p.suffix+'.pending')
    temp.write_bytes(canonical(value)); temp.replace(p)
def catalog():
    c = load(ROOT/'configs/model_training_p02a.json')
    return ReleaseCatalog(ROOT/c['export_root'], c['export_index_sha256'], c['release_manifest_sha256'])
def source_paths():
    return [*ROOT.glob('src/phi_jepa/**/*.py'), *ROOT.glob('tools/p12*.py'), ROOT/'tools/p10_common.py',ROOT/'configs/qualification_p12.json',
             ROOT/'configs/model_context_p02b.json', ROOT/'configs/model_training_p02a.json',ROOT/'MODEL_TRAINING_CONTRACT.md',
             ROOT/'docs/assets/p11_direct_answer_v1.json',ROOT/'docs/assets/p02b_enrichment_v1.json',ROOT/'AGENTS.md',ROOT/'configs/core-wsl-p02b.lock.txt']
def implementation_identity():
    return digest({str(p.relative_to(ROOT)):file_hash(p) for p in source_paths()})
def study_lock(proposal):
    if not proposal.get('enabled') or not proposal.get('authorization'):raise ValueError('separate study authorization required')
    if implementation_identity()!=proposal['implementation_sha256']:raise ValueError('frozen implementation mismatch')
    root=Path(proposal['study_root'])
    if not root.resolve().is_relative_to(NATIVE) or root.resolve().is_relative_to(OUT):raise ValueError('separate native study root required')
    selected={}
    for domain in proposal['domains']:
        if not (root/domain/'complete.json').exists():raise ValueError('all fresh domain fits must complete before confirmation')
        path=root/domain/'selected.json';selected[domain]=file_hash(path)
    identity={'selected':selected,'plan':digest(proposal),'confirmation':file_hash(OUT/'confirmation-public.json')}
    if identity['confirmation']!=proposal['confirmation_public_sha256']:raise ValueError('confirmation identity mismatch')
    path=root/'evaluation-lock.json'
    if path.exists() and load(path)!=identity:raise ValueError('selected checkpoints changed after evaluation lock')
    if not path.exists():save(path,identity)
    return identity
def snapshot(stage):
    paths=source_paths()
    hashes = {str(p.relative_to(ROOT)):file_hash(p) for p in paths}
    record = {'stage':stage,'commit':subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip(),
              'dirty':bool(subprocess.check_output(['git','status','--porcelain'],cwd=ROOT,text=True).strip()),'files':hashes}
    for p in paths:
        destination = OUT/'sources/blobs'/hashes[str(p.relative_to(ROOT))]
        if not destination.exists(): destination.parent.mkdir(parents=True,exist_ok=True); destination.write_bytes(p.read_bytes())
    save(OUT/'sources'/f'{stage}-{digest(record)}.json',record)
    return digest(record)
