"""Verify enrichment request provenance against exact approved provider identities."""
from p12_common import *
from phi_jepa.providers.cache import FrozenOutputCache
from phi_jepa.providers.context import parse_notes
from phi_jepa.integration.readers import PublicInputReader
from dataclasses import asdict
from collections import Counter

def main():
    c=load(ROOT/'configs/model_context_p02b.json');asset=load(ROOT/c['enrichment_asset']);cat=catalog()
    roots={p.parent for p in NATIVE.glob('**/*cache/*.json') if 'p12-' not in str(p)}
    indexes={p.name:p.parent for root in roots for p in root.glob('*.json')}
    rows=load(OUT/'cache-coverage.json');by_id={r['sample_id']:r for r in rows};verified=[]
    for domain,split in sorted(cat.partitions):
        if split not in ('train','validation'):continue
        wanted={r['sample_id'] for r in rows if (r['domain'],r['split'])==(domain,split) and r['enrichment_path']}
        path=cat.verified_file(domain,split,'inputs.jsonl')
        for problem in PublicInputReader(path,file_hash(path)):
            if problem.sample_id not in wanted:continue
            row=by_id[problem.sample_id];result={'sample_id':problem.sample_id,'domain':domain,'split':split,'status':'unverified_provider_origin'}
            for attempts in (1,3):
                config={**c['enrichment_provider'],'max_attempts_per_request':attempts}
                payload={'model':config['model'],'store':False,'instructions':asset['prompt'],'input':problem.context(problem.input['observation_cutoff']),
                         'reasoning':{'effort':config['reasoning_effort']},'max_output_tokens':config['max_output_tokens'],
                         'text':{'format':{'type':'json_schema','name':'public_context_notes','strict':True,'schema':asset['schema']}}}
                identity={'kind':'public_enrichment','implementation':'p02b-responses-v1','endpoint':'https://api.openai.com/v1/responses',
                          'asset':asset,'config':config,'payload':payload}
                key=digest(identity)+'.json';root=indexes.get(key)
                if root:
                    output=FrozenOutputCache(root).read(identity)
                    if output and parse_notes(problem,output['text'])==load(row['enrichment_path']) and output.get('metadata',{}).get('returned_model')=='gpt-5.6-sol':
                        result.update(status='verified',cache_file=str(root/key),cache_sha256=file_hash(root/key),request_sha256=digest(identity),returned_model='gpt-5.6-sol');break
            verified.append(result)
    save(OUT/'enrichment-origin-audit.json',{'records':verified,'counts':dict(Counter(r['status'] for r in verified)),
                                          'policy':'match full public request, approved asset/config, output checksum, exact notes and returned model; retry-policy variants 1 or 3 only'})
    print(Counter(r['status'] for r in verified))

if __name__=='__main__':main()
