"""Separate qualification run; no legacy budget/provider execution imports."""
from pathlib import Path
import json
import sys
import subprocess
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT/'src'))
from phi_jepa.artifacts import canonical, digest
from phi_jepa.integration.readers import file_hash, ReleaseCatalog
NATIVE = Path('/home/aashraf/phi-jepa')
def load(p): return json.loads(Path(p).read_text())
CONFIG = load(ROOT/'configs/qualification_p12.json')
OUT = Path(CONFIG['run_root'])
def save(p, value):
    p = Path(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    temp = p.with_suffix(p.suffix+'.pending')
    temp.write_bytes(canonical(value)); temp.replace(p)
def catalog():
    c = load(ROOT/'configs/model_training_p02a.json')
    return ReleaseCatalog(ROOT/c['export_root'], c['export_index_sha256'], c['release_manifest_sha256'])
def snapshot(stage):
    paths = [*ROOT.glob('src/phi_jepa/**/*.py'), *ROOT.glob('tools/p12*.py'), ROOT/'configs/qualification_p12.json',
             ROOT/'configs/model_context_p02b.json', ROOT/'configs/model_training_p02a.json',ROOT/'MODEL_TRAINING_CONTRACT.md']
    hashes = {str(p.relative_to(ROOT)):file_hash(p) for p in paths}
    record = {'stage':stage,'commit':subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip(),
              'dirty':bool(subprocess.check_output(['git','status','--porcelain'],cwd=ROOT,text=True).strip()),'files':hashes}
    for p in paths:
        destination = OUT/'sources/blobs'/hashes[str(p.relative_to(ROOT))]
        if not destination.exists(): destination.parent.mkdir(parents=True,exist_ok=True); destination.write_bytes(p.read_bytes())
    save(OUT/'sources'/f'{stage}-{digest(record)}.json',record)
    return digest(record)
