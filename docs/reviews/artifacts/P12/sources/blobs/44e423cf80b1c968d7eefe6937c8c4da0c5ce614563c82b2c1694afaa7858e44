"""Sequential eight-validation-question local qualification; never opens reference files."""
from p12_common import *
import time
from dataclasses import asdict
from importlib.metadata import version
from phi_jepa.providers.local_answer import LocalAnswerSettings,LocalAnswerBackend,prepare_tokens,request_identity,verify_cached_record
from phi_jepa.integration.contracts import PublicProblem

def main(condition,approved_plan=None):
    import torch
    from transformers import AutoTokenizer,AutoModelForCausalLM
    from p10_common import guard_deployment_io
    guard_deployment_io();torch.set_num_threads(2)
    run_root=OUT;rows_path=OUT/'diagnostic-public.json';limits=CONFIG['qualification'];diagnostic=True
    if approved_plan is not None:
        proposal=load(approved_plan)
        if not proposal.get('enabled') or not proposal.get('authorization'):raise ValueError('separate study authorization required')
        if implementation_identity()!=proposal['implementation_sha256']:raise ValueError('frozen implementation mismatch')
        if file_hash(OUT/'confirmation-public.json')!=proposal['confirmation_public_sha256']:raise ValueError('confirmation identity mismatch')
        previous=load(OUT/'local'/condition/'qualification.json')
        if not previous['status'].startswith('complete'):raise ValueError('local model qualification gate incomplete')
        run_root=Path(proposal['study_root']);rows_path=OUT/'confirmation-public.json';limits=proposal['evaluation_limits'];diagnostic=False
    cfg=next(c for c in CONFIG['models'] if c['condition']==condition);acquisition=load(OUT/'model-acquisition.json')[cfg['model']]
    folder=run_root/'local'/condition;folder.mkdir(parents=True,exist_ok=True)
    if acquisition['status']!='available':
        save(folder/'qualification.json',{'status':'blocked','reason':acquisition.get('failure_type','model_unavailable')});return
    source=snapshot('local-'+condition)
    tokenizer=AutoTokenizer.from_pretrained(cfg['model'],revision=acquisition['revision'],cache_dir=str(NATIVE/'model-cache'),local_files_only=True,trust_remote_code=False)
    settings=LocalAnswerSettings(cfg['model'],acquisition['revision'],acquisition['revision'],digest(tokenizer.chat_template),
        tuple((k,version(k)) for k in ('torch','transformers','tokenizers','safetensors')),cfg['enable_thinking'],
        max_new_tokens=CONFIG['qualification']['thinking_output_tokens'] if cfg['enable_thinking'] else CONFIG['qualification']['output_tokens'],
        max_seconds=CONFIG['qualification']['local_generation_seconds_per_request'],temperature=cfg['temperature'],top_p=cfg['top_p'],top_k=cfg['top_k'])
    instruction=load(ROOT/'docs/assets/p11_direct_answer_v1.json')['prompt']
    rows=load(rows_path)
    if diagnostic and (len(rows)>8 or any(r['split']!='validation' for r in rows)):raise ValueError('qualification cohort must be validation only, <=8')
    preflight=[]
    for row in rows:
        try:
            ids=prepare_tokens(tokenizer,PublicProblem.parse(row['public']),instruction,settings)
            expected=request_identity(settings,PublicProblem.parse(row['public']),instruction,ids)
            preflight.append({'sample_id':row['sample_id'],'domain':row['domain'],'input_tokens':len(ids),'status':'eligible','request_sha256':digest(expected)})
            path=folder/(row['sample_id']+'.json')
            if path.exists():verify_cached_record(load(path),expected)
        except ValueError as exc:
            if str(exc)=='incompatible local answer cache identity':raise
            preflight.append({'sample_id':row['sample_id'],'domain':row['domain'],'status':'rejected','reason':str(exc),
                              'input_tokens':getattr(exc,'input_tokens',None),'output_reserve':settings.max_new_tokens,'context_limit':settings.max_input_and_output})
    flight_record={'settings':asdict(settings),'rows':preflight,'source':source,'template':tokenizer.chat_template}
    save(folder/('resume-preflight.json' if (folder/'preflight.json').exists() else 'preflight.json'),flight_record)
    if all((folder/(r['sample_id']+'.json')).exists() for r in rows):
        print('All existing records match exact identities; no model calls.');return
    start=time.perf_counter()
    model=AutoModelForCausalLM.from_pretrained(cfg['model'],revision=acquisition['revision'],cache_dir=str(NATIVE/'model-cache'),
        local_files_only=True,trust_remote_code=False,use_safetensors=True,torch_dtype=torch.bfloat16,attn_implementation='sdpa').to('cuda')
    load_seconds=time.perf_counter()-start;backend=LocalAnswerBackend(model,tokenizer,settings,instruction)
    outputs=[]
    for row,flight in zip(rows,preflight):
        path=folder/(row['sample_id']+'.json')
        if path.exists():outputs.append(load(path));continue
        if flight['status']!='eligible':result={**flight,'status':'input_rejected','failure':flight['reason'],'answer':None}
        else:
            ledger_path=run_root/'local-budget.json'
            if ledger_path.exists():ledger=load(ledger_path)
            else:
                previous=[load(p) for p in (run_root/'local').glob('*/*.json') if len(p.stem)==32]
                ledger={'attempts':{v['request_sha256']:{'status':'finished','seconds':v['latency_seconds']} for v in previous if 'request_sha256' in v}}
            key=flight['request_sha256'];attempts=ledger['attempts']
            if key in attempts:raise ValueError('previous unresolved attempt; explicit new budget required')
            if len(attempts)>=limits['maximum_generation_requests']:raise ValueError('local request budget exhausted')
            if sum(v['seconds'] for v in attempts.values())+settings.max_seconds>limits['gpu_seconds']:raise ValueError('local GPU time budget exhausted')
            attempts[key]={'status':'reserved','seconds':settings.max_seconds};save(ledger_path,ledger)
            result=backend.answer(PublicProblem.parse(row['public']))
            attempts[key]={'status':'finished','seconds':result['latency_seconds']};save(ledger_path,ledger)
        result.update(domain=row['domain'],split=row['split'],scenario_id=row['scenario_id'],condition=condition)
        save(path,result);outputs.append(result);print(json.dumps({k:result.get(k) for k in ('domain','sample_id','status','latency_seconds','input_tokens','output_tokens')}),flush=True)
    save(folder/'qualification.json',{'status':'complete_with_recorded_failures' if any(r['status']!='success' for r in outputs) else 'complete',
                                     'settings':asdict(settings),'load_seconds':load_seconds,'requests':len(outputs),'seconds':time.perf_counter()-start,
                                     'valid_answers':sum(r['status']=='success' for r in outputs),'diagnostic_only':diagnostic,'source':source})

if __name__=='__main__':
    import argparse
    parser=argparse.ArgumentParser();parser.add_argument('condition');parser.add_argument('--approved-plan',type=Path)
    args=parser.parse_args();main(args.condition,args.approved_plan)
