"""Release-wide split/count/cache audit; never reads test reference outcomes."""
from p12_common import *
from collections import defaultdict,Counter
import time
import math
from dataclasses import asdict
from phi_jepa.integration.readers import json_lines,PublicInputReader,forecast_states
from phi_jepa.integration.contracts import validate_enrichment,enriched_context

def historical():
    roots=[p for p in NATIVE.iterdir() if p.is_dir() and p.name.startswith(('p07','p08','p10','p11'))]
    roots+=list((NATIVE/'manual-outputs').glob('*'))
    records=[]; exposed=set()
    for root in roots:
        selections=[p for p in (root/'selection.json',root/'selected-public.json') if p.exists()]
        record={'root':str(root),'selection_files':{},'sources':[]}
        for p in selections:
            value=load(p);record['selection_files'][str(p)]=file_hash(p)
            def walk(v):
                if isinstance(v,dict):
                    if v.get('split') in ('test_id','test_ood') or str(v.get('split','')).startswith('ood_'):
                        for key in ('sample_id','scenario_id','base_scenario_id','split_group'):
                            if isinstance(v.get(key),str): exposed.add(v[key])
                    for x in v.values():walk(x)
                elif isinstance(v,list):
                    for x in v:walk(x)
            walk(value)
            rows=value if isinstance(value,list) else value.get('rows',[])
            record['selected_rows']=len(rows)
        for p in [*root.glob('sources/*.json'),*root.glob('source/identity.json')]:
            s=load(p); files=s.get('files',s.get('source_files',{}))
            record['sources'].append({'path':str(p),'sha256':file_hash(p),'commit':s.get('commit',s.get('base_commit')),
                                       'file_count':len(files),'current_matching_files':sum((ROOT/k).is_file() and file_hash(ROOT/k)==v for k,v in files.items() if isinstance(v,str))})
        for name in ('config.json','plan.json','completion.json'):
            if (root/name).exists(): record[name]={'sha256':file_hash(root/name),'path':str(root/name)}
        records.append(record)
    save(OUT/'historical-source-inventory.json',records)
    return exposed

def main():
    started=time.time(); source=snapshot('audit');cat=catalog(); exposed=historical()
    cache_roots=[p.parent for p in NATIVE.glob('**/encoding-report.json') if 'p12-' not in str(p)]
    enrichment_paths=defaultdict(list)
    for p in NATIVE.glob('**/enrichment/*.json'):
        if 'p12-' not in str(p):enrichment_paths[p.stem].append(p)
    settings=load(ROOT/'configs/model_context_p02b.json')['encoder']
    # Tokenizer-only validates the exact encoder request identity, not just a sample filename.
    from phi_jepa.providers.qwen import QwenEncoder
    encoder=QwenEncoder(str(NATIVE/'model-cache'),runtime_versions=settings['runtime_versions'],load_model=False)
    encoder_settings=asdict(encoder.settings)
    selection=[]; diagnostic=[]; summary={}; unused=[]; all_groups={}; coverage=[]; seen_samples=set()
    for domain,split in sorted(cat.partitions):
        metas={r['sample_id']:r['metadata'] for r in json_lines(cat.verified_file(domain,split,'evaluator.jsonl'))}
        public_path=cat.verified_file(domain,split,'inputs.jsonl')
        rows=[];scenario_ids=set(); split_groups=set()
        for p in PublicInputReader(public_path,file_hash(public_path)):
            m=metas[p.sample_id];sid=p.sample_id; scenario=m['base_scenario_id'];group=m['split_group_id']
            if m['record_origin']!='simulation' or m['validation']['status']!='accepted':raise ValueError('nonadmitted')
            if sid in seen_samples:raise ValueError('duplicate sample across partitions')
            seen_samples.add(sid)
            if (domain,scenario) in all_groups and all_groups[domain,scenario]!=split:raise ValueError('scenario split leakage')
            if ('group',group) in all_groups and all_groups['group',group]!=(domain,split):raise ValueError('group split leakage')
            all_groups[domain,scenario]=split;all_groups['group',group]=(domain,split)
            scenario_ids.add(scenario);split_groups.add(group)
            row={'sample_id':sid,'scenario_id':scenario,'split_group':group,'domain':domain,'split':split,
                 'distribution':m['distribution'],'public_sha256':digest(p.input),'public':{'sample_id':sid,'schema_version':p.schema_version,'input':p.input}}
            rows.append(row)
            if split not in ('train','validation'):
                row['previously_inspected']=bool({sid,scenario,group}&exposed)
                if not row['previously_inspected']:unused.append({k:v for k,v in row.items() if k!='public'})
                continue
            note_candidates=[]
            for path in enrichment_paths[sid]:
                try:
                    notes=load(path);validate_enrichment(p,notes);note_candidates.append((path,notes))
                except (ValueError,KeyError,TypeError):pass
            result={'sample_id':sid,'domain':domain,'split':split,'matching_public_notes':len(note_candidates),
                    'enrichment_path':None,'embedding_path':None,'embedding_request_sha256':None}
            for path,notes in note_candidates:
                text=enriched_context(p,notes,p.input['observation_cutoff']);tokens=encoder.tokenize(text)
                request={'kind':'frozen_E','version':1,'settings':encoder_settings,'serialization':'P02a-Q-C-enrichment-v1',
                         'context_mode':'enriched','text':text,'tokens_sha256':digest(tokens)}
                result['enrichment_path']=str(path)
                for root in cache_roots:
                    candidate=root/'embeddings/enriched'/f'{sid}.json'
                    if not candidate.exists():continue
                    value=load(candidate)
                    if load(root/'encoding-report.json')['settings']!=encoder_settings:continue
                    if value.get('request_sha256')!=digest(request) or value.get('context_sha256')!=digest(text) or value.get('token_count')!=len(tokens):continue
                    if len(value.get('values',[]))!=1024 or not all(type(x) in (int,float) and math.isfinite(x) for x in value['values']):continue
                    result.update(embedding_path=str(candidate),embedding_request_sha256=digest(request));break
                if result['embedding_path']:break
            coverage.append(result)
        count={'scenarios':len(scenario_ids),'questions':len(rows),'groups':len(split_groups),'pairs':None}
        if split=='train':
            count['pairs']=sum(len(forecast_states(p,ref))-1 for p,ref,identity in cat.records(domain,split))
        if split in ('train','validation'):
            selection.extend({k:v for k,v in r.items() if k!='public'} for r in rows)
            cov=[c for c in coverage if (c['domain'],c['split'])==(domain,split)]
            count.update(enrichment_covered=sum(c['enrichment_path'] is not None for c in cov),embedding_covered=sum(c['embedding_path'] is not None for c in cov))
        if split=='validation':
            # Longest complete public input per scenario, then the two longest distinct scenarios.
            groups=defaultdict(list)
            for row in rows:groups[row['scenario_id']].append(row)
            longest=[max(group,key=lambda r:(len(canonical(r['public'])),r['sample_id'])) for group in groups.values()]
            diagnostic.extend(sorted(longest,key=lambda r:(-len(canonical(r['public'])),r['sample_id']))[:2])
        summary[f'{domain}/{split}']=count
        print(domain,split,count,flush=True)
    save(OUT/'selection.json',selection);save(OUT/'cache-coverage.json',coverage);save(OUT/'diagnostic-public.json',diagnostic)
    save(OUT/'unused-confirmation-candidates.json',unused)
    confirmation=[]
    for domain,split in sorted(cat.partitions):
        if split in ('train','validation'):continue
        candidates=[r for r in unused if (r['domain'],r['split'])==(domain,split)]
        groups=defaultdict(list)
        for r in candidates:groups[r['scenario_id']].append(r)
        # Frozen IDs only; no test references, answers or outcome metrics read.
        for gid in sorted(groups,key=lambda g:digest(['p12-confirmation',11,domain,split,g]))[:20]:confirmation.extend(groups[gid])
    save(OUT/'confirmation-cohort.json',confirmation)
    train=[v for k,v in summary.items() if k.endswith('/train')]
    totals={k:sum(v[k] for v in train) for k in ('scenarios','questions','pairs','enrichment_covered','embedding_covered')}
    if (totals['scenarios'],totals['questions'],totals['pairs'])!=(3721,6702,454130):raise ValueError('release_count_discrepancy')
    report={'source':source,'release_identity':cat.identity,'partitions':summary,'training_totals':totals,'seconds':time.time()-started,
            'test_reference_outcomes_opened':False,'cache_policy':'exact encoder settings/token/context/request binding; notes public binding checked; provider origin requires separate provenance audit',
            'confirmation_questions':len(confirmation),'previously_exposed_identifiers':len(exposed),'diagnostic_questions':len(diagnostic)}
    save(OUT/'audit.json',report)

if __name__=='__main__':main()
